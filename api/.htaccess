# Denegar acceso directo al fichero de configuración
<Files "config.php">
    Require all denied
</Files>

# Denegar acceso a la caché del token de Zoho
<Files "zoho_token_cache.json">
    Require all denied
</Files>

# Solo aceptar POST en los webhooks (Apache 2.4+)
<Files "webhook-zoho.php">
    <LimitExcept POST>
        Require all denied
    </LimitExcept>
</Files>

<Files "webhook-foto.php">
    <LimitExcept POST>
        Require all denied
    </LimitExcept>
</Files>

# No listar el directorio
Options -Indexes

# Scripts de depuración y librerías internas: no accesibles por HTTP
<FilesMatch "^(_test_.*\.php|lib\.php|auth-lib\.php|google-service-account\.json)$">
    Require all denied
</FilesMatch>
