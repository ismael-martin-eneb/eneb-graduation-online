# Denegar acceso directo al fichero de configuración
<Files "config.php">
    Require all denied
</Files>

# Solo aceptar POST en el webhook (Apache 2.4+)
<Files "webhook-zoho.php">
    <LimitExcept POST>
        Require all denied
    </LimitExcept>
</Files>

# No listar el directorio
Options -Indexes

# Evitar que PHP muestre errores en pantalla
php_flag display_errors Off
